rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidMemberProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'companyName',
        'memberType',
        'countryOrCounty',
        'membershipGrade',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'companyName',
        'memberType',
        'countryOrCounty',
        'membershipGrade',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && data.uid == userId
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
      && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120
      && data.memberType is string && data.memberType in ['buyer', 'kenyan_supplier']
      && data.countryOrCounty is string && data.countryOrCounty.size() >= 2 && data.countryOrCounty.size() <= 80
      && data.membershipGrade is string && data.membershipGrade == 'Standard'
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMemberInquiry(data, userId) {
      return data.keys().hasAll([
        'uid',
        'referenceCode',
        'mode',
        'subjectTitle',
        'companyName',
        'businessEmail',
        'categoryId',
        'quantity',
        'destinationPort',
        'notes',
        'status',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'referenceCode',
        'mode',
        'subjectTitle',
        'companyName',
        'businessEmail',
        'categoryId',
        'quantity',
        'destinationPort',
        'notes',
        'status',
        'createdAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && data.uid == userId
      && isValidId(data.uid)
      && data.referenceCode is string && data.referenceCode.size() >= 6 && data.referenceCode.size() <= 24
      && data.referenceCode.matches('^TK-INQ-[0-9]+$')
      && data.mode is string && data.mode in ['matchmaking', 'product-quote', 'supplier-contact', 'offer-rfq']
      && data.subjectTitle is string && data.subjectTitle.size() >= 2 && data.subjectTitle.size() <= 180
      && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120
      && data.businessEmail is string && data.businessEmail.size() >= 3 && data.businessEmail.size() <= 160
      && data.categoryId is string && data.categoryId.size() >= 2 && data.categoryId.size() <= 64
      && data.quantity is string && data.quantity.size() >= 1 && data.quantity.size() <= 100
      && data.destinationPort is string && data.destinationPort.size() <= 120
      && data.notes is string && data.notes.size() <= 1000
      && data.status is string && data.status == 'Submitted'
      && data.createdAt is timestamp;
    }

    match /members/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidMemberProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidMemberProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'companyName',
          'memberType',
          'countryOrCounty',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().membershipGrade == existing().membershipGrade
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;

      match /inquiries/{inquiryId} {
        allow get: if isValidId(userId) && isValidId(inquiryId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(inquiryId)
          && isOwner(userId)
          && isValidMemberInquiry(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/members/$(userId));
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
